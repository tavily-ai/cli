{
  "name": "@tavily/cli",
  "version": "0.3.0",
  "description": "Tavily CLI",
  "license": "MIT",
  "type": "module",
  "bin": {
    "tvly": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.1.0"
  },
  "scripts": {
    "build": "tsup",
    "test": "vitest run",
    "lint": "biome check",
    "typecheck": "tsc --noEmit",
    "check:publishable": "node -e \"const s=require('./package.json').dependencies['@tavily/core'];if(!/^[~^0-9]/.test(s)){console.error('@tavily/core is '+s+'; switch it to a registry semver range before publishing (a file: dependency makes the package uninstallable).');process.exit(1)}\"",
    "prepublishOnly": "npm run check:publishable && npm run lint && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@tavily/core": "file:vendor/tavily-core-1.1.0.tgz",
    "commander": "15.1.0",
    "marked": "18.1.3",
    "marked-terminal": "8.0.0",
    "picocolors": "1.1.1",
    "proper-lockfile": "4.1.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@types/node": "26.6.6",
    "@types/proper-lockfile": "4.1.4",
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  },
  "homepage": "https://tavily.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/tavily-ai/cli.git"
  },
  "bugs": {
    "url": "https://github.com/tavily-ai/cli/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "overrides": {
    "zod": "^4.6.6"
  }
}
