+import assert from "node:assert/strict";
+import { test } from "node:test";
+import { createServer } from "node:http";
+import { once } from "node:events";
+import { Readable } from "node:stream";
+import { AxiosError } from "axios";
+import {
+  tavily,
+  createTransport,
+  TavilyRequestError,
+  TavilyKeylessLimitError,
+} from "../dist/index.mjs";
+
+for (const key of ["TAVILY_API_KEY", "TAVILY_HTTP_PROXY", "TAVILY_HTTPS_PROXY", "TAVILY_PROJECT", "TAVILY_ORG_ID"]) {
+  delete process.env[key];
+}
+
+// Adapter stub: records the request and answers with a canned status/body, rejecting like axios does for non-2xx.
+function stub(status, data, calls = []) {
+  return async (config) => {
+    calls.push(config);
+    const response = { data, status, statusText: "", headers: {}, config, request: {} };
+    if (status >= 200 && status < 300) return response;
+    throw new AxiosError(`status ${status}`, "ERR_BAD_REQUEST", config, {}, response);
+  };
+}
+
+const fullOptions = {
+  apiKey: "tvly-key",
+  clientSource: "my-cli",
+  sessionId: "s1",
+  humanId: "h1",
+  clientName: "c1",
+  projectId: "p1",
+  orgId: "o1",
+};
+
+test("keyed headers carry credentials and identity", async () => {
+  const calls = [];
+  const t = createTransport({ ...fullOptions, adapter: stub(200, { ok: true }, calls) });
+  await t.post("search", { query: "x" });
+  const h = calls[0].headers;
+  assert.equal(h.get("Authorization"), "Bearer tvly-key");
+  assert.equal(h.get("X-Client-Source"), "my-cli");
+  assert.equal(h.get("X-Session-Id"), "s1");
+  assert.equal(h.get("X-Human-Id"), "h1");
+  assert.equal(h.get("X-Client-Name"), "c1");
+  assert.equal(h.get("X-Project-ID"), "p1");
+  assert.equal(h.get("X-Tavily-Orgid"), "o1");
+  assert.match(h.get("Content-Type"), /application\/json/);
+});
+
+test("keyless headers have the access mode and no Authorization", async () => {
+  const calls = [];
+  const t = createTransport({ adapter: stub(200, {}, calls) });
+  await t.post("search", {});
+  const h = calls[0].headers;
+  assert.equal(h.get("X-Tavily-Access-Mode"), "keyless");
+  assert.equal(h.get("Authorization"), undefined);
+});
+
+test("432 rejects with TavilyRequestError carrying status, body and docs", async () => {
+  const body = { detail: { error: "Plan limit" }, documentation: "https://docs.tavily.com/x" };
+  const t = createTransport({ apiKey: "k", adapter: stub(432, body) });
+  await assert.rejects(t.post("search", {}), (err) => {
+    assert.ok(err instanceof TavilyRequestError);
+    assert.equal(err.message, "Plan limit");
+    assert.equal(err.status, 432);
+    assert.equal(err.docs, "https://docs.tavily.com/x");
+    assert.deepEqual(err.body, body);
+    return true;
+  });
+});
+
+test("error without detail uses the status and JSON body as message", async () => {
+  const t = createTransport({ apiKey: "k", adapter: stub(500, { oops: 1 }) });
+  await assert.rejects(t.get("research/abc"), (err) => {
+    assert.ok(err instanceof TavilyRequestError);
+    assert.equal(err.message, '500 Error: {"oops":1}');
+    assert.equal(err.docs, undefined);
+    return true;
+  });
+});
+
+const envelope = { error: { code: "keyless_hourly_cap", message: "Cap hit", retry_after_seconds: 5 } };
+
+test("keyless envelope: TavilyRequestError when keyed, TavilyKeylessLimitError when keyless", async () => {
+  const keyed = createTransport({ apiKey: "k", adapter: stub(429, envelope) });
+  await assert.rejects(keyed.post("search", {}), (err) => {
+    assert.ok(err instanceof TavilyRequestError);
+    assert.equal(err.status, 429);
+    return true;
+  });
+  const keyless = createTransport({ adapter: stub(429, envelope) });
+  await assert.rejects(keyless.post("search", {}), (err) => {
+    assert.ok(err instanceof TavilyKeylessLimitError);
+    assert.equal(err.capType, "keyless_hourly_cap");
+    return true;
+  });
+});
+
+test("post and get return the raw snake_case body", async () => {
+  const body = { response_time: 1.5, request_id: "r", results: [{ raw_content: "x" }] };
+  const calls = [];
+  const t = createTransport({ apiKey: "k", apiBaseURL: "http://example.test", adapter: stub(200, body, calls) });
+  assert.deepEqual(await t.post("search", { query: "q" }), body);
+  assert.deepEqual(await t.get("research/abc", { params: { include_usage: true } }), body);
+  assert.equal(calls[0].url, "http://example.test/search");
+  assert.equal(calls[1].url, "http://example.test/research/abc");
+  assert.deepEqual(calls[1].params, { include_usage: true });
+});
+
+test("timeouts default to 60s except research, and abort with the same message", async () => {
+  const calls = [];
+  const t = createTransport({ apiKey: "k", adapter: stub(200, {}, calls) });
+  await t.post("search", {});
+  await t.post("research", {});
+  await t.post("search", {}, { timeoutSeconds: 5 });
+  assert.equal(calls[0].timeout, 60000);
+  assert.ok(!calls[1].timeout, "research has no default timeout (axios normalizes to 0)");
+  assert.equal(calls[2].timeout, 5000);
+
+  const timingOut = async (config) => {
+    throw new AxiosError("timeout", "ECONNABORTED", config);
+  };
+  const t2 = createTransport({ apiKey: "k", adapter: timingOut });
+  await assert.rejects(t2.post("search", {}, { timeoutSeconds: 7 }), { message: "Request timed out after 7 seconds." });
+});
+
+test("stream yields the chunks", async () => {
+  const t = createTransport({ apiKey: "k", adapter: stub(200, Readable.from([Buffer.from("a"), Buffer.from("b")])) });
+  const chunks = [];
+  for await (const chunk of await t.stream("research", { input: "x", stream: true })) chunks.push(chunk.toString());
+  assert.deepEqual(chunks, ["a", "b"]);
+});
+
+test("stream rejects with a parsed TavilyRequestError on error status", async () => {
+  const body = Readable.from([Buffer.from(JSON.stringify({ detail: { error: "Plan limit" } }))]);
+  const t = createTransport({ apiKey: "k", adapter: stub(432, body) });
+  await assert.rejects(t.stream("research", {}), (err) => {
+    assert.ok(err instanceof TavilyRequestError);
+    assert.equal(err.status, 432);
+    assert.equal(err.message, "Plan limit");
+    return true;
+  });
+});
+
+test("client.search still returns camelCase", async () => {
+  process.env.NO_PROXY = "127.0.0.1";
+  const srv = createServer((req, res) => {
+    req.resume();
+    res.setHeader("Content-Type", "application/json");
+    res.end(JSON.stringify({
+      images: [],
+      results: [{ title: "T", url: "https://e.com", content: "c", raw_content: "r", score: 1 }],
+      response_time: 0.1,
+      request_id: "id",
+    }));
+  });
+  srv.listen(0, "127.0.0.1");
+  await once(srv, "listening");
+  try {
+    const client = tavily({ apiKey: "k", apiBaseURL: `http://127.0.0.1:${srv.address().port}` });
+    const res = await client.search("q");
+    assert.equal(res.responseTime, 0.1);
+    assert.equal(res.requestId, "id");
+    assert.equal(res.results[0].rawContent, "r");
+  } finally {
+    await new Promise((r) => srv.close(r));
+  }
+});
