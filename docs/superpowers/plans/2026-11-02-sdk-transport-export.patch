+import axios, { AxiosAdapter, AxiosError, AxiosRequestConfig, AxiosResponse } from "axios";
+import { HttpsProxyAgent } from "https-proxy-agent";
+import { Readable } from "stream";
+import {
+  TavilyClientOptions,
+  TavilyProxyOptions,
+  TavilyRequestConfig,
+} from "./types";
+import {
+  BASE_URL,
+  buildHeaders,
+  handleRequestError,
+  handleTimeoutError,
+} from "./utils";
+
+export type TavilyTransport = {
+  post(
+    endpoint: string,
+    body: Record<string, unknown>,
+    opts?: { timeoutSeconds?: number }
+  ): Promise<unknown>;
+  get(
+    endpoint: string,
+    opts?: { timeoutSeconds?: number; params?: Record<string, unknown> }
+  ): Promise<unknown>;
+  stream(
+    endpoint: string,
+    body: Record<string, unknown>,
+    opts?: { timeoutSeconds?: number }
+  ): Promise<AsyncIterable<Buffer>>;
+};
+
+/** Resolves credentials, proxies, project and org from options, falling back to the environment. */
+export function resolveRequestConfig(options?: TavilyClientOptions): TavilyRequestConfig {
+  const apiKey = options?.apiKey || process.env.TAVILY_API_KEY;
+  const proxies = (() => {
+    const http = options?.proxies?.http || process.env.TAVILY_HTTP_PROXY;
+    const https = options?.proxies?.https || process.env.TAVILY_HTTPS_PROXY;
+
+    const result = {} as TavilyProxyOptions;
+
+    if (http) result.http = http;
+    if (https) result.https = https;
+
+    return Object.keys(result).length > 0 ? result : undefined;
+  })();
+
+  return {
+    ...(apiKey ? { apiKey } : {}),
+    proxies,
+    apiBaseURL: options?.apiBaseURL,
+    clientSource: options?.clientSource,
+    projectId: options?.projectId || process.env.TAVILY_PROJECT,
+    orgId: options?.orgId || process.env.TAVILY_ORG_ID,
+    sessionId: options?.sessionId,
+    humanId: options?.humanId,
+    clientName: options?.clientName,
+  };
+}
+
+async function readJsonBody(stream: Readable): Promise<unknown> {
+  const chunks: Buffer[] = [];
+  for await (const chunk of stream) chunks.push(Buffer.from(chunk));
+  const text = Buffer.concat(chunks).toString("utf8");
+  try {
+    return JSON.parse(text);
+  } catch {
+    return text;
+  }
+}
+
+export function createTransport(
+  options: TavilyClientOptions & { adapter?: AxiosAdapter } = {}
+): TavilyTransport {
+  const { adapter, ...clientOptions } = options;
+  const requestConfig = resolveRequestConfig(clientOptions);
+  const { proxies, apiBaseURL } = requestConfig;
+  const isKeyless = !requestConfig.apiKey;
+
+  function axiosConfig(
+    endpoint: string,
+    timeoutSeconds: number | undefined,
+    extra: AxiosRequestConfig = {}
+  ): AxiosRequestConfig {
+    // Research endpoints have no default timeout.
+    const timeout = endpoint.includes("research") ? timeoutSeconds : timeoutSeconds ?? 60;
+    const config: AxiosRequestConfig = { headers: buildHeaders(requestConfig), ...extra };
+    if (timeout !== undefined) config.timeout = timeout * 1000;
+    if (proxies?.http) config.httpAgent = new HttpsProxyAgent(proxies.http);
+    if (proxies?.https) config.httpsAgent = new HttpsProxyAgent(proxies.https);
+    if (adapter) config.adapter = adapter;
+    return config;
+  }
+
+  async function send<T>(
+    timeoutSeconds: number | undefined,
+    request: () => Promise<T>
+  ): Promise<T> {
+    try {
+      return await request();
+    } catch (err) {
+      if (err instanceof AxiosError) {
+        if (err.code === "ECONNABORTED") {
+          handleTimeoutError(timeoutSeconds ?? 0);
+        }
+        if (err.response) {
+          const response = err.response as AxiosResponse;
+          if (response.data instanceof Readable) {
+            response.data = await readJsonBody(response.data);
+          }
+          handleRequestError(response, isKeyless);
+        }
+      }
+      throw new Error(
+        `An unexpected error occurred while making the request. Error: ${err}`
+      );
+    }
+  }
+
+  const url = (endpoint: string) => `${apiBaseURL || BASE_URL}/${endpoint}`;
+
+  return {
+    async post(endpoint, body, opts) {
+      const { timeoutSeconds } = opts ?? {};
+      const config = axiosConfig(endpoint, timeoutSeconds);
+      return (await send(timeoutSeconds, () => axios.post(url(endpoint), body, config))).data;
+    },
+
+    async get(endpoint, opts) {
+      const { timeoutSeconds, params } = opts ?? {};
+      const config = axiosConfig(endpoint, timeoutSeconds, { params });
+      return (await send(timeoutSeconds, () => axios.get(url(endpoint), config))).data;
+    },
+
+    async stream(endpoint, body, opts) {
+      const { timeoutSeconds } = opts ?? {};
+      const config = axiosConfig(endpoint, timeoutSeconds, { responseType: "stream" });
+      const response = await send(timeoutSeconds, () =>
+        axios.post(url(endpoint), body, config)
+      );
+
+      async function* chunks(): AsyncGenerator<Buffer, void, unknown> {
+        const stream = response.data as Readable;
+        try {
+          for await (const chunk of stream) {
+            if (chunk) {
+              yield chunk;
+            }
+          }
+        } finally {
+          if (!stream.destroyed) {
+            stream.destroy();
+          }
+        }
+      }
+
+      return chunks();
+    },
+  };
+}
